# Copier ce fichier en `.env` et remplacer chaque CHANGE_ME par TA valeur.
# ⚠️ Le vrai `.env` n'est jamais committé (voir .gitignore à la racine).

# --- Telegram ---
# Jeton donné par @BotFather à la création du bot
BOT_TOKEN=CHANGE_ME_JETON_BOTFATHER
# Identifiant numérique du SEUL chat autorisé (voir README → « Trouver son chat_id »)
ALLOWED_CHAT=CHANGE_ME_CHAT_ID

# --- Clés API (lecture seule) ---
# Jellyfin : Tableau de bord → Clés API
JF_TOKEN=CHANGE_ME_CLE_API_JELLYFIN
# Jellyseerr : Paramètres → Général → Clé API
JS_TOKEN=CHANGE_ME_CLE_API_JELLYSEERR

# --- Adresses internes (noms de conteneurs sur le réseau Docker) ---
# Décommenter uniquement si tes noms/ports diffèrent des valeurs par défaut.
# PROM_URL=http://prometheus:9090
# JF_URL=http://jellyfin:8096
# JS_URL=http://jellyseerr:5055
# GPU_URL=http://nvidia-exporter:9835/metrics

# --- Divers ---
# BACKUP_DIR=/backups
# SERVER_NAME=homelab
