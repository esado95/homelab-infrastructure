# Modèle de configuration Grafana.
# Copier en `grafana.env` dans ce dossier et remplacer les CHANGE_ME.
# ⚠️ Le vrai fichier n'est JAMAIS committé (voir .gitignore).

# --- Compte administrateur local ---
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME

# --- Adresse publique (liens dans les e-mails d'alerte) ---
GF_SERVER_ROOT_URL=https://grafana.example.com

# --- Envoi des e-mails d'alerte (SMTP de mon hébergeur) ---
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.example.com:465
GF_SMTP_USER=alertes@example.com
GF_SMTP_PASSWORD=CHANGE_ME
GF_SMTP_FROM_ADDRESS=alertes@example.com
GF_SMTP_FROM_NAME=Homelab Monitoring

# --- Destinataires des alertes (utilisés par provisioning/alerting/contact-points.yml) ---
ALERT_EMAIL_TO=admin@example.com
TG_BOT_TOKEN=CHANGE_ME
TG_CHAT_ID=CHANGE_ME

# --- Connexion via le SSO Keycloak ---
# Le rôle Keycloak `infra-admin` donne les droits d'administration ;
# tous les autres comptes entrent en simple lecture.
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Keycloak
GF_AUTH_GENERIC_OAUTH_AUTO_LOGIN=true
GF_AUTH_GENERIC_OAUTH_ALLOW_SIGN_UP=true
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=admin-gate
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=CHANGE_ME
GF_AUTH_GENERIC_OAUTH_SCOPES=openid email profile
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.example.com/realms/homelab/protocol/openid-connect/auth
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.example.com/realms/homelab/protocol/openid-connect/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.example.com/realms/homelab/protocol/openid-connect/userinfo
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(realm_access.roles[*],'infra-admin') && 'GrafanaAdmin' || 'Viewer'
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=true

# --- Intégration des « tuiles » dans le portail interne ---
# Nécessaire pour afficher des panneaux Grafana dans une iframe.
# À n'activer que si l'accès au portail est déjà protégé en amont (proxy + SSO).
GF_SECURITY_ALLOW_EMBEDDING=true
GF_SECURITY_COOKIE_SECURE=true
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_NAME=Main Org.
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# --- Tableau de bord affiché à la connexion ---
GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/dashboards/node-exporter-full.json
