# Homarr — exemple de configuration.
# Copier en `.env` (jamais versionné) et remplacer les CHANGE_ME.

# Clé servant à chiffrer les identifiants des intégrations stockés en base.
# À générer une seule fois :  openssl rand -hex 32
SECRET_ENCRYPTION_KEY=CHANGE_ME_64_CARACTERES_HEX

# --- Authentification -------------------------------------------------------
# `oidc`        : connexion via Keycloak (le mode normal)
# `credentials` : compte local gardé en secours si Keycloak est indisponible
AUTH_PROVIDERS=oidc,credentials

AUTH_OIDC_ISSUER=https://auth.example.com/realms/homelab
AUTH_OIDC_CLIENT_ID=admin-gate
AUTH_OIDC_CLIENT_SECRET=CHANGE_ME
AUTH_OIDC_CLIENT_NAME=Homelab SSO

# Nom du claim qui transporte les groupes. Côté Keycloak, un mapper
# « realm roles → claim groups » doit être ajouté au client (sans chemin complet),
# sinon Homarr ne reçoit aucun groupe et personne n'est administrateur.
AUTH_OIDC_GROUPS_ATTRIBUTE=groups
AUTH_OIDC_SCOPES=openid email profile
