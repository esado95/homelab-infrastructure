# --- Passerelle SSO (oauth2-proxy) ---
# Copier ce fichier en `.env` à côté de `compose.yaml`, puis remplir avec TES valeurs.
# ⚠️ Le vrai `.env` n'est jamais committé (voir .gitignore) — droits conseillés : chmod 600

# Secret du client confidentiel `admin-gate`
# Keycloak > Clients > admin-gate > Credentials > Client secret
OAUTH2_PROXY_CLIENT_SECRET=CHANGE_ME_secret_du_client_admin-gate

# Clé de chiffrement du cookie de session (32 octets, base64 « url-safe ») :
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_generer_une_cle_de_32_octets

# --- Facultatif : à décommenter si tu adaptes le domaine ou le realm ---
# (sinon ces valeurs sont fixées dans `compose.yaml`)
# OAUTH2_PROXY_OIDC_ISSUER_URL=https://auth.example.com/realms/homelab
# OAUTH2_PROXY_COOKIE_DOMAINS=.example.com
# OAUTH2_PROXY_WHITELIST_DOMAINS=.example.com
